                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Товары"
        ],
        "summary": "Обновить товар",
        "description": "Частичное обновление информации о товаре",
        "operationId": "updateProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
