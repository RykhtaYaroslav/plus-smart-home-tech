  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP-статус",
            "format": "int32",
            "example": 404
          },
          "message": {
            "type": "string",
            "description": "Сообщение об ошибке",
            "example": "Товар не найден"
          },
          "timestamp": {
            "type": "string",
            "description": "Время ошибки",
            "format": "date-time"
          },
          "validationErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Детали ошибок валидации (если есть)"
            },
            "description": "Детали ошибок валидации (если есть)"
          }
        },
        "description": "Ответ с информацией об ошибке"
      },
      "CreateProductRequest": {
        "required": [
          "name",
          "price"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "description": "Название товара",
            "example": "Умная лампа ShtLight LED"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "description": "Описание товара",
            "example": "Светодиодная лампа с поддержкой Wi-Fi"
          },
          "price": {
            "minimum": 0.01,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Цена в рублях",
            "example": 2490.0
          },
          "categoryId": {
            "type": "integer",
            "description": "ID категории",
            "format": "int64",
            "example": 1
          },
          "imageUrl": {
            "type": "string",
            "description": "URL изображения товара"
          }
        },
        "description": "Запрос на создание товара"
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID категории",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Название категории",
            "example": "Освещение"
          },
          "description": {
            "type": "string",
            "description": "Описание категории",
            "example": "Умные лампы и светильники"
          }
        },
        "description": "Категория товаров"
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID товара",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Название товара",
            "example": "Умная лампа ShtLight LED"
          },
          "description": {
            "type": "string",
            "description": "Описание товара",
            "example": "Светодиодная лампа с поддержкой Wi-Fi"
          },
          "price": {
            "type": "number",
            "description": "Цена в рублях",
            "example": 2490.0
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDto"
          },
          "imageUrl": {
            "type": "string",
            "description": "URL изображения товара"
          },
          "active": {
            "type": "boolean",
            "description": "Товар активен и доступен для продажи",
            "example": true
          }
        },
        "description": "Информация о товаре"
      },
      "CreateCategoryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "description": "Название категории",
            "example": "Освещение"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Описание категории",
            "example": "Умные лампы и светильники"
          }
        },
        "description": "Запрос на создание категории"
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "description": "Название товара",
            "example": "Умная лампа ShtLight LED v2"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "description": "Описание товара"
          },
          "price": {
            "minimum": 0.01,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Цена в рублях",
            "example": 2990.0
          },
          "categoryId": {
            "type": "integer",
            "description": "ID категории",
            "format": "int64",
            "example": 1
          },
          "imageUrl": {
            "type": "string",
            "description": "URL изображения товара"
          },
          "active": {
            "type": "boolean",
            "description": "Товар активен",
            "example": true
          }
        },
        "description": "Запрос на обновление товара"
      }
    }
  }
