        ],
        "summary": "Получить товар по ID",
        "description": "Возвращает подробную информацию о товаре",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID товара",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
