                    "$ref": "#/components/schemas/CategoryDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Категории"
        ],
        "summary": "Создать категорию",
        "description": "Создаёт новую категорию товаров",
        "operationId": "createCategory",
        "requestBody": {
          "content": {
